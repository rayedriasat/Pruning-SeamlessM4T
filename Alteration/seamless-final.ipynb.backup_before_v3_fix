\n    # Check 6: Unit IDs exist and valid\n    if uid is None:\n        return False, \"unit_ids is None\"\n    \n    if not isinstance(uid, torch.Tensor):\n        return False, f\"unit_ids wrong type: {type(uid)}\"\n    \n    if uid.numel() < 1:\n        return False, \"unit_ids is empty\"\n    \n    # Check 7: Speaker embedding valid\n    if spk_emb is None:\n        return False, \"spk_emb is None\"\n    \n    if not isinstance(spk_emb, torch.Tensor):\n        return False, f\"spk_emb wrong type: {type(spk_emb)}\"\n    \n    if spk_emb.shape[-1] != 192:\n        return False, f\"spk_emb wrong dim: {spk_emb.shape} (expected 192)\"\n    \n    return True, \"OK\"\n\n\n# Validate saved KD data\nprint('Validating saved KD data...')\ninvalid_samples = []\nfor idx, sample in enumerate(kd_data):\n    is_valid, error = validate_kd_sample(\n        sample.get('t2u_input'),\n        sample.get('unit_ids'),\n        sample.get('spk_emb')\n    )\n    if not is_valid:\n        invalid_samples.append((idx, sample['id'], error))\n\nif invalid_samples:\n    print(f'⚠️ Found {len(invalid_samples)} invalid samples:')\n    for idx, sid, err in invalid_samples[:10]:\n        print(f'  [{idx}] {sid}: {err}')\nelse:\n    print(f'✅ All {len(kd_data)} samples validated successfully!')\n","metadata":{"execution":{"iopub.status.busy":"2026-04-24T17:30:59.604178Z","iopub.execute_input":"2026-04-24T17:30:59.605157Z","iopub.status.idle":"2026-04-24T17:31:00.743512Z","shell.execute_reply.started":"2026-04-24T17:30:59.605127Z","shell.execute_reply":"2026-04-24T17:31:00.742559Z"},"trusted":true},"outputs":[{"name":"stdout","text":"Validating saved KD data...\n✅ All 1600 samples validated successfully!\n","output_type":"stream"}],"execution_count":59},{"cell_type":"code","source":"if kd_data:\n    # Verify the captured t2u_input is actually 1024-dim hidden states\n    sample_check = [x for x in kd_data if x.get('t2u_input') is not None][0]\n    t2u_in = sample_check['t2u_input']\n    assert t2u_